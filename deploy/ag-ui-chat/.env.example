# AG-UI Chat Environment Configuration
# Copy this file to .env and modify as needed

# OpenCode Server WebSocket URL
#WS_URL=ws://localhost:5000/ag-ui/ws

# Ollama Host - Configure remote Ollama instance
# Default: http://localhost:11434
# For remote host (e.g., 100.94.136.15):
OLLAMA_HOST=http://100.94.136.15:11434

# Session ID for chat sessions
#SESSION_ID=test-session

# Authentication Token (min 10 characters)
#AUTH_TOKEN=dev-token-12345

# Default Model
#MODEL=ollama/llama3.2-vision:11b
