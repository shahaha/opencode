// packages/console/package.json (test scripts section)
{
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:perf": "playwright test performance/",
    "test:all": "npm run test:coverage && npm run test:e2e && npm run test:perf",
    "test:ci": "npm run test:coverage && npm run test:e2e"
  }
}
